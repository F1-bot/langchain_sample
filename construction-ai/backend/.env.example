# Скопіюйте цей файл у .env і підставте свої ключі.
# .env у git НЕ комітиться.

# ══════════════════════════════════════════════════════════════════
# ОБОВ'ЯЗКОВІ КЛЮЧІ
# ══════════════════════════════════════════════════════════════════

# Google Gemini — https://aistudio.google.com/apikey
# Безкоштовний тариф покриває цю лабораторну з запасом.
GOOGLE_API_KEY=...

# Tavily (веб-пошук) — https://app.tavily.com
# Безкоштовно 1000 запитів на місяць.
TAVILY_API_KEY=...

# ══════════════════════════════════════════════════════════════════
# МОДЕЛЬ
# ══════════════════════════════════════════════════════════════════
# gemini-3.5-flash-lite — безкоштовний тариф, швидка, для цієї роботи
# більш ніж достатня. Потрібна розумніша — gemini-3.8-flash.
#
# НЕ ставте сюди gemini-2.0-flash-exp: саме це значення стояло в
# торішньому .env.example, а модель вимкнено 9 грудня 2025. Симптом —
# 404 NOT_FOUND на першому ж виклику агента.
# Актуальний перелік: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash-lite
TEMPERATURE=0.3
MAX_TOKENS=2048

# ══════════════════════════════════════════════════════════════════
# LANGSMITH — НЕОБОВ'ЯЗКОВО
# ══════════════════════════════════════════════════════════════════
# Трейсинг: показує дерево викликів агента. Без цих рядків проєкт
# працює повністю, просто трейси нікуди не йдуть.
#
# Ключ безкоштовний: smith.langchain.com -> Settings -> API Keys.
# Зверніть увагу на імена: LANGCHAIN_* перейменовано на LANGSMITH_*.
# Старі імена поки що читаються, але нове пишіть так.
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=construction-ai

# ══════════════════════════════════════════════════════════════════
# СЕРВЕР
# ══════════════════════════════════════════════════════════════════
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
